d$vaccine<-as.factor(d$vaccine)
d$sex<-as.factor(d$sex)
d$age<-as.factor(d$age)
d$race<-as.factor(d$race)
d$region<-as.factor(d$region)
d$date<-as.factor(d$date)

d$over50<-ifelse(d$age=="50-54" | d$age=="55-59", 1, 0)
d$over60<-ifelse(d$age == "60-64" | d$age == "65-69"| d$age == "70-74"| d$age== "75-79" | d$age == "80+", 1, 0)

tree1<-ctree(vaccine~sex+over50+over60, data=d)
plot(tree1)

tree2<-ctree(vaccine~sex+over50+over60+region, data=d)
plot(tree2)

tree3<-ctree(vaccine~sex+over60+region+race, data=d)
plot(tree3)

##over 65 instead
d$over65<-ifelse(d$age == "65-69"| d$age == "70-74"| d$age== "75-79" | d$age == "80+", 1, 0)
tree5<-ctree(vaccine~sex+over65+race+region, data=d)
plot(tree5)

#everything
tree6<-ctree(vaccine~sex+age+race+region)

